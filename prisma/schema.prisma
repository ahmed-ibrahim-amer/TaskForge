generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
    USER
    ADMIN
}

model User {
    id        String   @id @default(uuid())
    email     String   @unique
    password  String  
    role      Role     @default(USER)
    createdAt DateTime @default(now())
    jobs      Job[]
}



enum JobType {
  REPORT
  EMAIL_BATCH
  DATA_EXPORT
}

enum JobStatus {
  PENDIND
  RUNNING
  COMPLETED
  FAILED
}

enum LogStatus {
  SUCCESS
  FAILED
}

model Job {
id         String      @id @default(uuid())
type       JobType
status     JobStatus   @default(PENDIND)
payload    Json
retryCount Int         @default(0)
userId     String
user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
logs       JobLog[]
cratedAt   DateTime    @default(now())
updatedAt  DateTime    @updatedAt
}

model JobLog {
  id           String       @id @default(uuid())
  jobId        String
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempt      Int
  status       LogStatus
  errorMessage String?
  createdAt    DateTime     @default(now())
}

